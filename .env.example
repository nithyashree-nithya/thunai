# Copy this file to .env and edit. Never commit .env.

PORT=3000

# Leave the two PayPal values empty to run in demo mode (payments are simulated).
# For the PayPal sandbox, create an app at https://developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The public address of this server. PayPal returns the customer here and the QR code points here.
# Leave empty locally (http://localhost:PORT is used). On Render it is filled in automatically.
BASE_URL=

# Protects the payout endpoints and the dashboard's send button. Choose a long random value.
ADMIN_TOKEN=change-me

# Example exchange rate used to convert rupees to US dollars. Use a live rate in production.
FX_RATE_INR_PER_USD=90

# Adds sample history so the dashboard is not empty. Set to false for real use.
SEED_DEMO=true

# Where the demo data is stored.
DATA_FILE=data/db.json

# Sandbox payouts: set these to the emails of PayPal sandbox personal accounts.
NGO_EMAIL_N1=
NGO_EMAIL_N2=
NGO_EMAIL_N3=
